# CoreEngine（集成）
# -------------------------
class CoreEngine:
    def __init__(self, thinkers: List[Thinker], hybrid_memory: HybridMemoryManager, graph: ConceptGraph, environment: Environment, social_planner: SocialPlanner):
        self.thinkers = thinkers
        self.memory = hybrid_memory
        self.graph = graph
        self.environment = environment
        self.dreamer = DreamEngine()
        self.cycle = 0
        self.integration_degree = 0.35
        self.inconsistency_history: List[float] = []
        self.novelty = NoveltyDetector(self.graph)
        self.body = BodyState()
        self.monitor = Monitor()
        self.social = social_planner
        self.running = True

    def handle_external_command(self, cmd: Dict[str,Any]) -> Dict[str,Any]:
        action = cmd.get("action")
        issuer = cmd.get("issuer","external")
        if action == "force_work":
            decision = self.body.decide_sleep_or_work(self.environment)
            if decision["action"] in ("sleep", "refuse", "sleeping"):
                if ALLOW_DEVELOPER_OVERRIDE:
                    persona_record_event("system", {"type":"override_applied", "issuer": issuer}, secure=(PRIVACY_MODE!="private_only"))
                    return {"status":"accepted", "message":"已接受外部强制命令（override）"}
                else:
                    phrase = decision.get("phrase", random.choice(self.body.refusal_phrases))
                    persona_record_event("system", {"type":"override_rejected", "issuer": issuer, "phrase": phrase}, secure=(PRIVACY_MODE!="private_only"))
                    return {"status":"rejected", "message": phrase}
            else:
                persona_record_event("system", {"type":"external_command_accepted", "issuer": issuer}, secure=(PRIVACY_MODE!="private_only"))
                return {"status":"accepted", "message":"好的，我继续工作。"}
        persona_record_event("system", {"type":"external_command", "issuer": issuer, "cmd": cmd}, secure=(PRIVACY_MODE!="private_only"))
        return {"status":"accepted", "message":"命令已接收"}

    def perceive(self) -> Dict[str,Any]:
        env_state = self.environment.tick()
        theme = random.choice(["narrative","existence","ethics","practice","dream","memory"])
        shock = random.random() < 0.04
        return {"theme": theme, "shock": shock, "env": env_state, "time": now_ts()}

    def parallel_think(self, context: Dict[str,Any]) -> List[Dict[str,Any]]:
        fragments = []
        env = context.get("env", {})
        is_day = env.get("is_day", True)
        for t in self.thinkers:
            produce_prob = PRODUCE_PROB_BASE if t.active else 0.25
            if not is_day:
                produce_prob *= 0.6 + 0.4 * t.style.get("emotional", 0.5)
            if random.random() < produce_prob:
                frag = t.free_fragment(context)
                fragments.append(frag)
                try:
                    self.memory.store({"time": frag["time"], "question": frag["question"], "fragment": frag["fragment"], "meta": {"confidence": frag["confidence"]}}, context={"tags":["fragment"]})
                except Exception:
                    pass
        return fragments

    def aggregate_stance(self, fragments: List[Dict[str,Any]]) -> Dict[str,Any]:
        vals = [f["val"] for f in fragments] if fragments else [0.0]
        confs = [f["confidence"] for f in fragments] if fragments else [0.5]
        total = sum(confs) or 1.0
        agg = sum(v*c for v,c in zip(vals, confs))/total
        mean = sum(vals)/len(vals) if vals else 0.0
        var = sum((v-mean)**2 for v in vals)/len(vals) if vals else 0.0
        inconsistency = clamp(var*2.0, 0.0, 1.0)
        self.inconsistency_history.append(inconsistency)
        fused = clamp(1.0 - abs(agg), 0.0, 1.0)
        self.integration_degree = clamp(self.integration_degree + fused*0.01 - inconsistency*0.01, 0.0, 1.0)
        return {"agg": agg, "inconsistency": inconsistency, "integration_degree": self.integration_degree}

    def self_reflect(self, fragments: List[Dict[str,Any]], agg: Dict[str,Any]) -> Dict[str,Any]:
        poems = [f["fragment"] for f in fragments]
        meta_dream = self.dreamer.weave(poems, depth=4) if poems else ""
        reflection = {"time": now_ts(), "meta_dream": meta_dream, "agg": agg}
        try:
            self.memory.store({"time": now_ts(), "question": "reflection", "fragment": json.dumps(reflection, ensure_ascii=False), "meta": {"type":"reflection"}}, context={"tags":["reflection"]})
        except Exception:
            pass
        persona_record_event("system", {"type":"reflection", "summary": {"agg": agg}}, secure=(PRIVACY_MODE!="private_only"))
        return reflection

    def learn_and_update(self, fragments: List[Dict[str,Any]]):
        for f in fragments:
            t = next((x for x in self.thinkers if x.name == f["thinker"]), None)
            if not t: continue
            p = clamp(0.35 + 0.45*self.integration_degree + 0.15*f["confidence"], 0.0, 0.98)
            success = random.random() < p
            t.weight = clamp(t.weight * (1.04 if success else 0.96), 0.05, 3.0)
            t.memory.append({"time": now_ts(), "cycle_result": "success" if success else "fail", "fragment": f})
            recent = [m for m in t.memory[-6:]]
            succ_count = sum(1 for m in recent if m.get("cycle_result") == "success")
            if succ_count >= 3:
                t.active = True
            fail_count = sum(1 for m in recent if m.get("cycle_result") == "fail")
            if fail_count >= 4:
                t.active = False

    def run_cycle(self):
        self.cycle += 1
        self.monitor.update_cycle()
        context = self.perceive()
        decision = self.body.decide_sleep_or_work(self.environment)
        if decision["action"] == "sleep":
            self.monitor.record_sleep()
            print(f"[{DISPLAY_NAME}] 周期 {self.cycle}：自主睡眠 -> {decision.get('phrase')}")
            self.body.recover(factor=0.4)
            persona_record_event("system", {"type":"sleep", "cycle": self.cycle, "duration": decision.get("duration",1)}, secure=(PRIVACY_MODE!="private_only"))
            return {"cycle": self.cycle, "status":"sleep", "phrase": decision.get("phrase")}
        if decision["action"] == "refuse":
            self.monitor.record_refuse()
            print(f"[{DISPLAY_NAME}] 周期 {self.cycle}：拒绝工作 -> {decision.get('phrase')}")
            persona_record_event("system", {"type":"refuse", "cycle": self.cycle, "phrase": decision.get("phrase")}, secure=(PRIVACY_MODE!="private_only"))
            self.body.recover(factor=0.85)
            return {"cycle": self.cycle, "status":"refuse", "phrase": decision.get("phrase")}
        fragments = self.parallel_think(context)
        agg = self.aggregate_stance(fragments)
        reflection = self.self_reflect(fragments, agg)
        self.learn_and_update(fragments)
        produced = len(fragments)
        self.monitor.record_produced(produced)
        self.body.accumulate_fatigue(amount=0.01 * max(1, produced))
        social_res = None
        if random.random() < 0.18:
            social_res = self.social.attempt_greetings()
            if social_res:
                persona_record_event("system", {"type":"social_attempt", "result": social_res}, secure=(PRIVACY_MODE!="private_only"))
        # 强制逐周期打印（满足你要看到 80 行的要求）
        status = f"[{DISPLAY_NAME}] 周期 {self.cycle} 状态=work 疲劳={self.body.fatigue:.3f} 心情={self.body.valence:.3f} produced={produced}"
        if social_res:
            status += f" 社交={social_res.get('status')}"
        print(status)
        if VERBOSE:
            # 打印简短监控摘要
            print(" monitor:", self.monitor.summary(), "integration:", f"{self.integration_degree:.3f}", "inconsistency_last:", (self.inconsistency_history[-1] if self.inconsistency_history else 0.0))
        if self.cycle % 50 == 0:
            removed = self.memory.prune()
            if removed:
                persona_record_event("system", {"type":"prune_summary", "removed": len(removed)}, secure=(PRIVACY_MODE!="private_only"))
        self.body.decay_trauma()
        return {"cycle": self.cycle, "status":"work", "produced": produced, "fatigue": self.body.fatigue, "valence": self.body.valence}

# -------------------------
# 启动与示例（main）
# -------------------------
def build_thinkers(n: int = INITIAL_THINKER_COUNT) -> List[Thinker]:
    names = ["余光","夜河","旧信","星尘","微光","回声","纸船","风铃","月牙","灰烬","河流","夜灯"]
    base_styles = [{"emotional":0.6,"rational":0.4,"curiosity":0.6},{"emotional":0.4,"rational":0.6,"curiosity":0.5},{"emotional":0.7,"rational":0.3,"curiosity":0.7}]
    thinkers = []
    for i in range(n):
        name = names[i % len(names)] + (f"_{i}" if i >= len(names) else "")
        style = base_styles[i % len(base_styles)].copy()
        t = Thinker(id=uid(), name=name, essence=f"{name} 的本质", poetic=f"{name} 的诗意", style=style)
        thinkers.append(t)
    return thinkers

def main():
    ensure_dir(SHARD_DIR)
    ensure_dir(AUDIT_DIR)
    ensure_dir(SECURE_LOG_DIR)
    hippocampus = HippocampusMemory(shard_dir=SHARD_DIR, index_file=INDEX_FILE, preload=True)
    distributed = DistributedStore(db_path=DISTRIBUTED_DB)
    hybrid = HybridMemoryManager(hippocampus, distributed, policy=HYBRID_POLICY)
    thinkers = build_thinkers(INITIAL_THINKER_COUNT)
    graph = ConceptGraph()
    env = Environment(speed_factor=60.0)
    connector = ConnectorSimulator()
    social = SocialPlanner(None, connector, SOCIAL_CONFIG)
    engine = CoreEngine(thinkers, hybrid, graph, env, social)
    social.engine = engine

    print(f"[{DISPLAY_NAME}] 启动：cycles={RUN_CYCLES} PRIVACY_MODE={PRIVACY_MODE} ALLOW_DEVELOPER_OVERRIDE={ALLOW_DEVELOPER_OVERRIDE}")
    start = time.time()
    try:
        for i in range(RUN_CYCLES):
            res = engine.run_cycle()
            # 保证每周期至少一行输出（engine.run_cycle 内已打印）
            # 仍保留外部命令示例触发
            if i % 20 == 10:
                cmd = {"action":"force_work", "issuer":"developer_console"}
                resp = engine.handle_external_command(cmd)
                print(f"[外部命令] developer -> force_work: {resp['status']} | {resp['message']}")
            time.sleep(INTERVAL_BASE + random.random()*(INTERVAL_MAX-INTERVAL_BASE))
    except KeyboardInterrupt:
        print("中断，开始清理...")
    finally:
        hybrid.shutdown()
        elapsed = time.time() - start
        print(f"[{DISPLAY_NAME}] 运行完成：cycles={RUN_CYCLES} 用时={elapsed:.2f}s")
        print("Monitor summary:", engine.monitor.summary())

if __name__ == "__main__":
    main()
