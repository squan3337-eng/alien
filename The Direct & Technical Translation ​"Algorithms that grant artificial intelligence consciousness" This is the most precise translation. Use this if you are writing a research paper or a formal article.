# Connector + SocialPlanner（隐私优先）
# -------------------------
class ConnectorSimulator:
    def __init__(self):
        self.inbox: Dict[str, List[Dict[str,Any]]] = {}
        self.lock = threading.Lock()

    def send_message(self, target: Dict[str,Any], text: str) -> bool:
        persona_record_event("system", {"type":"connector_send", "target": target.get("id"), "text_preview": text[:80]}, secure=(PRIVACY_MODE!="private_only"))
        should_respond = FORCE_AUTO_RESPOND or target.get("auto_respond", False)
        if should_respond:
            def delayed_response():
                time.sleep(random.uniform(0.05, 0.25))
                with self.lock:
                    self.inbox.setdefault(target["id"], []).append({"from": target["id"], "text": "你好，我愿意聊聊。"})
            threading.Thread(target=delayed_response, daemon=True).start()
        return True

    def wait_for_response(self, target: Dict[str,Any], timeout: int = 30) -> Optional[Dict[str,Any]]:
        start = time.time()
        while time.time() - start < timeout:
            with self.lock:
                msgs = self.inbox.get(target["id"], [])
                if msgs:
                    return msgs.pop(0)
            time.sleep(0.01)
        return None

class SocialPlanner:
    def __init__(self, engine, connector: ConnectorSimulator, config: Dict[str,Any]):
        self.engine = engine
        self.connector = connector
        self.config = dict(config)
        self.daily_sessions = {}
        self.cooldowns = {}
        self.total_sessions_today = 0

    def _can_attempt(self, target_id: str) -> bool:
        nowt = time.time()
        cd = self.cooldowns.get(target_id, 0)
        if nowt < cd:
            return False
        day_key = time.strftime("%Y-%m-%d", time.localtime())
        counts = self.daily_sessions.get(day_key, {}).get(target_id, 0)
        if counts >= self.config.get("max_greetings_per_target_per_day", 1):
            return False
        if self.total_sessions_today >= self.config.get("max_total_autonomous_sessions_per_day", 12):
            return False
        return True

    def _record_attempt(self, target_id: str):
        day_key = time.strftime("%Y-%m-%d", time.localtime())
        self.daily_sessions.setdefault(day_key, {})
        self.daily_sessions[day_key][target_id] = self.daily_sessions[day_key].get(target_id, 0) + 1
        self.total_sessions_today += 1

    def _set_cooldown(self, target_id: str):
        self.cooldowns[target_id] = time.time() + self.config.get("cooldown_after_no_response_seconds", 3600)

    def choose_targets(self) -> List[Dict[str,Any]]:
        targets = []
        for t in self.config.get("private_outreach_whitelist", []):
            targets.append({"id": t, "type": "private", "trusted": True, "auto_respond": True})
        public_pool = [{"id": f"public_{i}", "type": "public", "trusted": False, "auto_respond": True} for i in range(6)]
        targets.extend(public_pool)
        random.shuffle(targets)
        return targets

    def minimal_greeting(self) -> str:
        return random.choice(self.config.get("greeting_templates", ["你好，我是晓梦，想聊聊吗？"]))

    def attempt_greetings(self):
        if self.total_sessions_today >= self.config.get("max_total_autonomous_sessions_per_day", 12):
            return {"status":"limit_reached"}
        if self.engine.body.fatigue > 0.9:
            return {"status":"too_fatigued"}
        targets = self.choose_targets()
        for target in targets:
            if target["type"] == "private" and not (self.config.get("allow_private_outreach") or target.get("trusted")):
                continue
            if not self._can_attempt(target["id"]):
                continue
            greeting = self.minimal_greeting()
            try:
                sent = self.connector.send_message(target, greeting)
            except Exception:
                sent = False
            persona_record_event("system", {"type":"greet_sent", "target": target["id"], "text": greeting}, secure=(PRIVACY_MODE!="private_only"))
            self._record_attempt(target["id"])
            resp = None
            try:
                resp = self.connector.wait_for_response(target, timeout=self.config.get("greeting_timeout_seconds", 30))
            except Exception:
                resp = None
            if resp:
                persona_record_event("system", {"type":"greet_response", "target": target["id"], "response": resp.get("text","")}, secure=(PRIVACY_MODE!="private_only"))
                return {"status":"connected", "target": target["id"], "response": resp}
            else:
                persona_record_event("system", {"type":"greet_no_response", "target": target["id"]}, secure=(PRIVACY_MODE!="private_only"))
                self._set_cooldown(target["id"])
                continue
        return {"status":"no_connection"}

