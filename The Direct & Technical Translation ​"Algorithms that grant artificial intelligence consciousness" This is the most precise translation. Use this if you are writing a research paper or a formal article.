# Monitor（简单监控）
# -------------------------
class Monitor:
    def __init__(self):
        self.metrics = {"cycles": 0, "produced": 0, "sleep_count": 0, "refuse_count": 0}
        self.disrupt_probability = 0.02
        self.fatigue_alert_threshold = 0.85

    def update_cycle(self):
        self.metrics["cycles"] += 1

    def record_produced(self, n: int):
        self.metrics["produced"] += n

    def record_sleep(self):
        self.metrics["sleep_count"] += 1

    def record_refuse(self):
        self.metrics["refuse_count"] += 1

    def should_disrupt(self) -> bool:
        return random.random() < self.disrupt_probability

    def summary(self) -> Dict[str,Any]:
        return dict(self.metrics)

