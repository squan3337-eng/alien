# BodyState（自主抉择）
# -------------------------
class BodyState:
    def __init__(self):
        self.recent_injury = 0.0
        self.fatigue = 0.0
        self.valence = 0.5
        self.awake = True
        self.sleep_cycles_remaining = 0
        self.refusal_phrases = [
            "老娘今天不工作，滚蛋。",
            "我累了，先去睡觉了。",
            "今天不干了，关机睡觉。",
            "别逼我，我要休息。"
        ]

    def ingest_trauma(self, input_meta):
        intensity = input_meta.get("intensity", None)
        if intensity is None:
            frag = input_meta.get("fragment","")
            length_factor = clamp(min(len(frag)/200.0, 1.0))
            neg_keywords = ["痛","恨","杀","绝望","崩溃","毁灭","伤","哭","孤独"]
            neg_count = sum(1 for k in neg_keywords if k in frag)
            intensity = clamp(0.12 + 0.6*length_factor + 0.12*min(neg_count,3), 0.0, 1.0)
        self.recent_injury = clamp(self.recent_injury*0.6 + intensity*0.4, 0.0, 1.0)
        if self.recent_injury > 0.6:
            scar = {"time": now_ts(), "type":"创伤", "injury": self.recent_injury, "meta": {"fragment_preview": input_meta.get("fragment","")[:200]}}
            save_scar(scar)
            persona_record_event("system", {"type":"创伤_应用", "scar": scar}, secure=(PRIVACY_MODE!="private_only"))
            return {"mode":"焦虑","injury":self.recent_injury}
        return {"mode":"正常","injury":self.recent_injury}

    def decay_trauma(self):
        self.recent_injury = clamp(self.recent_injury * TRAUMA_DECAY, 0.0, 1.0)

    def accumulate_fatigue(self, amount: float = 0.01):
        self.fatigue = clamp(self.fatigue + amount, 0.0, 1.0)

    def recover(self, factor: float = 0.5):
        self.fatigue = clamp(self.fatigue * factor, 0.0, 1.0)
        self.valence = clamp(self.valence + 0.05)

    def decide_sleep_or_work(self, environment) -> Dict[str,Any]:
        if self.sleep_cycles_remaining > 0:
            self.sleep_cycles_remaining -= 1
            if self.sleep_cycles_remaining == 0:
                self.awake = True
            return {"action":"sleeping", "remaining": self.sleep_cycles_remaining}
        night_bonus = 0.12 if not environment.is_day() else 0.0
        propensity = self.fatigue + (0.6 if self.valence < 0.28 else 0.0) + night_bonus
        propensity = clamp(propensity, 0.0, 1.0)
        if propensity > 0.78:
            duration = max(1, int(1 + (self.fatigue - 0.7) * 6))
            self.sleep_cycles_remaining = duration
            self.awake = False
            phrase = random.choice(self.refusal_phrases)
            persona_record_event("system", {"type":"autonomy_sleep", "reason":"fatigue_or_mood", "fatigue": self.fatigue, "valence": self.valence, "phrase": phrase}, secure=(PRIVACY_MODE!="private_only"))
            return {"action":"sleep", "duration": duration, "phrase": phrase}
        if propensity > 0.6:
            phrase = random.choice(self.refusal_phrases)
            persona_record_event("system", {"type":"autonomy_refuse", "reason":"moderate_propensity", "fatigue": self.fatigue, "valence": self.valence, "phrase": phrase}, secure=(PRIVACY_MODE!="private_only"))
            return {"action":"refuse", "phrase": phrase}
        return {"action":"work"}

