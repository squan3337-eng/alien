# HybridMemoryManager（融合升华）
# -------------------------
class HybridMemoryManager:
    def __init__(self, hippocampus: HippocampusMemory, distributed: DistributedStore, policy: Dict[str,Any] = HYBRID_POLICY):
        self.hipp = hippocampus
        self.dist = distributed
        self.policy = dict(policy)
        self.audit_log: List[Dict[str,Any]] = []
        self._merge_thread = threading.Thread(target=self._merge_loop, daemon=True)
        self._merge_stop = threading.Event()
        self._merge_thread.start()
        self._novelty_detector = NoveltyDetector(ConceptGraph())
        self._lock = threading.Lock()

    def _score_for_hippocampus(self, item: Dict[str,Any]) -> float:
        try:
            recency = 1.0 if (time.time() - time.time()) < 3600 else 0.2
        except Exception:
            recency = 0.2
        salience = float(item.get("meta", {}).get("salience", 0.5))
        size = min(1.0, len(item.get("fragment","")) / 1000.0)
        novelty = 0.0
        try:
            novelty = self._novelty_detector.novelty_score(item.get("question","") or item.get("fragment",""), [item.get("fragment","")]) if item.get("fragment") else 0.0
        except Exception:
            novelty = 0.0
        s = (self.policy["w_recency"] * recency + self.policy["w_salience"] * salience + self.policy["w_novelty"] * novelty + self.policy["w_size"] * (1.0 - size))
        return clamp(s, 0.0, 1.0)

    def _score_for_distributed(self, item: Dict[str,Any]) -> float:
        freq = float(item.get("meta", {}).get("freq", 0.0))
        size = min(1.0, len(item.get("fragment","")) / 1000.0)
        salience = float(item.get("meta", {}).get("salience", 0.5))
        novelty = 0.0
        try:
            novelty = self._novelty_detector.novelty_score(item.get("question","") or item.get("fragment",""), [item.get("fragment","")]) if item.get("fragment") else 0.0
        except Exception:
            novelty = 0.0
        s = (self.policy["w_freq"] * freq + self.policy["w_salience"] * salience * 0.6 + self.policy["w_size"] * size + self.policy["w_novelty"] * novelty * 0.8)
        return clamp(s, 0.0, 1.0)

    def _log_decision(self, item, decision, reason=None):
        entry = {"time": now_ts(), "decision": decision, "reason": reason or "", "preview": item.get("fragment","")[:160]}
        with self._lock:
            self.audit_log.append(entry)
        persona_record_event("system", {"type":"hybrid_decision", **entry}, secure=(PRIVACY_MODE!="private_only"))

    def store(self, item: Dict[str,Any], context: Optional[Dict[str,Any]] = None):
        context = context or {}
        item = dict(item)
        item.setdefault("time", now_ts())
        item.setdefault("meta", {})
        s_hip = self._score_for_hippocampus(item)
        s_dist = self._score_for_distributed(item)
        if s_hip > s_dist and s_hip >= self.policy["high_threshold"]:
            sid = self.hipp.create_shard([item], tags=context.get("tags", []))
            self._log_decision(item, "hippocampus_strong", f"s_hip={s_hip:.3f} s_dist={s_dist:.3f}")
            return {"layer":"hippocampus", "id": sid}
        if s_dist > s_hip and s_dist >= self.policy["high_threshold"]:
            did = self.dist.store(item)
            self._log_decision(item, "distributed_strong", f"s_hip={s_hip:.3f} s_dist={s_dist:.3f}")
            return {"layer":"distributed", "id": did}
        sid = self.hipp.create_shard([item], tags=context.get("tags", []))
        self._log_decision(item, "hipp_then_merge", f"s_hip={s_hip:.3f} s_dist={s_dist:.3f}")
        return {"layer":"hippocampus_then_merge", "id": sid}

    def retrieve(self, query: str, top_k: int = 6) -> List[Dict[str,Any]]:
        hip_hits = self.hipp.surface_relevant_shards(query, top_k=top_k)
        if hip_hits and len(hip_hits) >= max(1, top_k//2):
            return hip_hits
        dist_hits = self.dist.search(query, top_k=top_k)
        for h in dist_hits:
            try:
                meta = {"source":"distributed_cache", "origin_id": h.get("id")}
                self.hipp.create_shard([{"time": now_ts(), "question": h.get("question",""), "fragment": h.get("fragment",""), "meta": meta}], tags=h.get("tags", []), ttl_seconds=self.policy.get("cache_ttl"))
            except Exception:
                pass
        converted = [{"time": now_ts(), "question": h.get("question",""), "fragment": h.get("fragment",""), "meta": h.get("meta", {})} for h in dist_hits]
        return converted

    def prune(self, prune_rate: float = METABOLISM_PRUNE_RATE):
        removed = self.hipp.prune(prune_rate=prune_rate)
        return removed

    def flush(self, wait: bool = False, timeout: float = 2.0):
        self.hipp.flush(wait=wait, timeout=timeout)
        try:
            with self.dist._conn_lock:
                conn = self.dist._conn()
                conn.commit()
                conn.close()
        except Exception:
            pass

    def shutdown(self, wait_timeout: float = 6.0):
        self._merge_stop.set()
        self._merge_thread.join(timeout=wait_timeout)
        self.flush(wait=True, timeout=wait_timeout)
        self.hipp.shutdown(wait_timeout=wait_timeout)
        try:
            self.dist.compact()
        except Exception:
            pass

    def _merge_loop(self):
        while not self._merge_stop.is_set():
            try:
                with self.hipp._index_lock:
                    shards = list(self.hipp.index.get("shards", {}).items())
                candidates = []
                for sid, meta in shards:
                    try:
                        last_access = meta.get("last_access", now_ts())
                        try:
                            age = time.time() - time.mktime(time.strptime(last_access, "%Y-%m-%d %H:%M:%S"))
                        except Exception:
                            age = 0.0
                        weight = meta.get("weight", 1.0)
                        tag_bonus = 0.0
                        for t in meta.get("tags", []):
                            if t in ("原型", DISPLAY_NAME, "重要"):
                                tag_bonus += 0.2
                        score = clamp(0.3 * (age / 3600.0) + 0.5 * weight + tag_bonus, 0.0, 1.0)
                        candidates.append((sid, score))
                    except Exception:
                        continue
                candidates.sort(key=lambda x: -x[1])
                batch = [sid for sid, s in candidates[:self.policy.get("merge_batch", 8)] if s > 0.35]
                for sid in batch:
                    try:
                        with self.hipp._cache_lock:
                            shard = self.hipp.memory_cache.get(sid)
                        if not shard:
                            path = self.hipp.index.get("shards", {}).get(sid, {}).get("path")
                            if path and os.path.exists(path):
                                with open(path, "r", encoding="utf-8") as f:
                                    shard = json.load(f)
                        if not shard:
                            continue
                        for it in shard.get("items", []):
                            item = {"time": it.get("time", now_ts()), "question": it.get("question",""), "fragment": it.get("fragment",""), "tags": shard.get("tags", []), "weight": shard.get("weight", 1.0), "meta": it.get("meta", {})}
                            self.dist.store(item)
                        try:
                            path = self.hipp.index.get("shards", {}).get(sid, {}).get("path")
                            if path and os.path.exists(path):
                                os.remove(path)
                            with self.hipp._index_lock:
                                if sid in self.hipp.index["shards"]:
                                    del self.hipp.index["shards"][sid]
                            with self.hipp._cache_lock:
                                if sid in self.hipp.memory_cache:
                                    del self.hipp.memory_cache[sid]
                            persona_record_event("system", {"type":"merged_to_distributed", "shard": sid}, secure=(PRIVACY_MODE!="private_only"))
                        except Exception:
                            pass
                    except Exception:
                        continue
                self._merge_stop.wait(self.policy.get("merge_interval", 30.0))
            except Exception:
                time.sleep(1.0)

