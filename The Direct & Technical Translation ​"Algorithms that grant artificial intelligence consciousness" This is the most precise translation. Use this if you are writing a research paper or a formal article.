class DreamEngine:
    def __init__(self):
        self.symbols = ["余晖","火海","毛衣","星河","旧照片","夜灯","河流","灰烬","回声","窗","纸船","风铃","月牙"]
        self.phrases = ["像未说完的歌","在胸口低语","像潮汐的呼吸","像旧信封的边角","像夜里的一盏灯","像被遗忘的香气","像指尖的温度","像雨后泥土的味道"]

    def weave(self, fragments: List[str], depth: int = 6) -> str:
        picks = random.sample(self.symbols, k=min(len(self.symbols), depth+2))
        weave = " · ".join(picks) + " — "
        parts = []
        for _ in range(depth):
            frag = random.choice(fragments) if fragments else random.choice(self.phrases)
            phrase = random.choice(self.phrases)
            parts.append(f"{frag}，{phrase}")
        weave += " / ".join(parts)
        return weave

