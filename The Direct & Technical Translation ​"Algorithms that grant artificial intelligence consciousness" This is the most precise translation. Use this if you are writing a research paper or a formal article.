# -------------------------
# 本地密钥管理与加密（AES-GCM）
# -------------------------
def load_or_create_local_key(path: str = LOCAL_KEY_PATH) -> bytes:
    if os.path.exists(path):
        try:
            return open(path, "rb").read()
        except Exception:
            pass
    k = os.urandom(32)
    try:
        with open(path, "wb") as f:
            f.write(k)
        try:
            os.chmod(path, 0o600)
        except Exception:
            pass
    except Exception:
        pass
    return k

LOCAL_KEY = load_or_create_local_key()

def encrypt_bytes(data: bytes, key: bytes) -> str:
    if AES:
        iv = os.urandom(12)
        cipher = AES.new(key, AES.MODE_GCM, nonce=iv)
        ct, tag = cipher.encrypt_and_digest(data)
        payload = iv + tag + ct
        return base64.b64encode(payload).decode()
    else:
        return base64.b64encode(data).decode()

def decrypt_bytes(payload_b64: str, key: bytes) -> bytes:
    payload = base64.b64decode(payload_b64)
    if AES:
        iv, tag, ct = payload[:12], payload[12:28], payload[28:]
        cipher = AES.new(key, AES.MODE_GCM, nonce=iv)
        return cipher.decrypt_and_verify(ct, tag)
    else:
        return payload

def secure_log_write(name: str, obj: Any):
    try:
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        enc = encrypt_bytes(data, LOCAL_KEY)
        path = os.path.join(SECURE_LOG_DIR, f"{name}.log")
        with open(path, "w", encoding="utf-8") as f:
            f.write(enc)
    except Exception:
        pass

def secure_log_read(path: str) -> Any:
    try:
        enc = open(path, "r", encoding="utf-8").read()
        data = decrypt_bytes(enc, LOCAL_KEY)
        return json.loads(data.decode("utf-8"))
    except Exception:
        return None

def secure_log_delete(path: str):
    try:
        if os.path.exists(path):
            os.remove(path)
    except Exception:
        pass

