# -------------------------
# ConceptGraph + NoveltyDetector
# -------------------------
@dataclass
class Concept:
    id: str
    label: str
    prototypes: List[str] = field(default_factory=list)
    tags: List[str] = field(default_factory=list)
    weight: float = 1.0
    time: str = field(default_factory=now_ts)

class ConceptGraph:
    def __init__(self):
        self.nodes: Dict[str, Concept] = {}
        self.edges: Dict[Tuple[str,str], Dict[str,Any]] = {}

    def add_concept(self, label: str, prototypes: Optional[List[str]] = None, tags: Optional[List[str]] = None) -> str:
        cid = uid()
        c = Concept(id=cid, label=label, prototypes=prototypes or [], tags=tags or [])
        self.nodes[cid] = c
        return cid

    def link(self, a: str, b: str, rel: str = "related", weight: float = 1.0):
        self.edges[(a,b)] = {"rel": rel, "weight": weight}
        self.edges[(b,a)] = {"rel": rel, "weight": weight}

class NoveltyDetector:
    def __init__(self, graph: ConceptGraph):
        self.graph = graph

@staticmethod
    def _tokenize(text: str) -> List[str]:
        text = text.lower()
        toks = []
        cur = []
        for ch in text:
            if ch.isalnum() or '\u4e00' <= ch <= '\u9fff':
                cur.append(ch)
            else:
                if cur:
                    toks.append("".join(cur))
                    cur = []
        if cur:
            toks.append("".join(cur))
        return toks

@staticmethod
    def _tf_vector(tokens: List[str]) -> Dict[str, float]:
        tf = {}
        for t in tokens:
            tf[t] = tf.get(t, 0) + 1
        total = len(tokens) or 1
        for k in list(tf.keys()):
            tf[k] = tf[k] / total
        return tf

@staticmethod
    def _cosine_sim(a: Dict[str,float], b: Dict[str,float]) -> float:
        dot = 0.0
        for k,v in a.items():
            dot += v * b.get(k, 0.0)
        na = math.sqrt(sum(v*v for v in a.values()))
        nb = math.sqrt(sum(v*v for v in b.values()))
        if na == 0 or nb == 0:
            return 0.0
        return dot / (na * nb)

    def novelty_score(self, candidate_label: str, candidate_prototypes: List[str]) -> float:
        cand_tokens = self._tokenize(candidate_label + " " + " ".join(candidate_prototypes))
        cand_vec = self._tf_vector(cand_tokens)
        max_sim = 0.0
        for cid, concept in self.graph.nodes.items():
            text = concept.label + " " + " ".join(concept.prototypes)
            toks = self._tokenize(text)
            vec = self._tf_vector(toks)
            sim = self._cosine_sim(cand_vec, vec)
            if sim > max_sim:
                max_sim = sim
        novelty = clamp(1.0 - max_sim, 0.0, 1.0)
        novelty = clamp(novelty * 0.9 + random.random()*0.1, 0.0, 1.0)
        return novelty

# -------------------------
# HippocampusMemory（短期缓存）与 DistributedStore（持久层）
# -------------------------
class HippocampusMemory:
    def __init__(self, shard_dir: str = SHARD_DIR, index_file: str = INDEX_FILE, preload: bool = True, max_memory_shards: Optional[int] = 2000):
        self.shard_dir = shard_dir
        self.index_file = index_file
        self.preload = preload
        self.max_memory_shards = max_memory_shards
        ensure_dir(self.shard_dir)

        self.memory_cache: Dict[str, Dict[str, Any]] = {}
        self.index: Dict[str, Any] = {"shards": {}}
        self._index_lock = threading.Lock()
        self._cache_lock = threading.Lock()

        self._write_q: "queue.Queue" = queue.Queue()
        self._writer_thread = threading.Thread(target=self._writer_loop, daemon=True)
        self._writer_thread.start()

        self._load_index_and_hydrate()

    def _load_index_and_hydrate(self):
        try:
            with open(self.index_file, "r", encoding="utf-8") as f:
                idx = json.load(f)
            with self._index_lock:
                self.index = idx
        except Exception:
            with self._index_lock:
                self.index = {"shards": {}}

        if self.preload:
            for sid, meta in list(self.index.get("shards", {}).items()):
                path = meta.get("path")
                if path and os.path.exists(path):
                    try:
                        with open(path, "r", encoding="utf-8") as f:
                            data = json.load(f)
                        with self._cache_lock:
                            self.memory_cache[sid] = data
                    except Exception:
                        pass

    def _writer_loop(self):
        while True:
            task = self._write_q.get()
            if task is None:
                break
            path, data = task
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
            except Exception:
                pass

    def _save_index_async(self):
        try:
            with self._index_lock:
                idx_copy = dict(self.index)
            self._write_q.put((self.index_file, idx_copy))
        except Exception:
            pass

    def create_shard(self, items: List[Dict[str, Any]], tags: Optional[List[str]] = None, ttl_seconds: Optional[int] = None) -> str:
        sid = uid()
        shard_data = {
            "id": sid,
            "items": items,
            "tags": tags or [],
            "weight": 1.0,
            "last_access": now_ts(),
            "ttl_seconds": ttl_seconds
        }
        path = os.path.join(self.shard_dir, f"{sid}.json")
        with self._cache_lock:
            self.memory_cache[sid] = shard_data
            if self.max_memory_shards and len(self.memory_cache) > self.max_memory_shards:
                k = next(iter(self.memory_cache))
                self._evict_shard_to_disk(k)
        with self._index_lock:
            self.index["shards"][sid] = {"path": path, "tags": tags or [], "weight": 1.0, "last_access": shard_data["last_access"]}
        self._write_q.put((path, shard_data))
        self._save_index_async()
        return sid

    def _evict_shard_to_disk(self, sid: str):
        try:
            with self._cache_lock:
                data = self.memory_cache.pop(sid, None)
            if data:
                path = self.index["shards"].get(sid, {}).get("path", os.path.join(self.shard_dir, f"{sid}.json"))
                self._write_q.put((path, data))
        except Exception:
            pass

    def append_to_shard(self, sid: str, item: Dict[str, Any]):
        with self._cache_lock:
            data = self.memory_cache.get(sid)
            if data is not None:
                data["items"].append(item)
                data["last_access"] = now_ts()
            else:
                path = None
                with self._index_lock:
                    meta = self.index["shards"].get(sid)
                    path = meta.get("path") if meta else None
                if path and os.path.exists(path):
                    try:
                        with open(path, "r", encoding="utf-8") as f:
                            data = json.load(f)
                        data["items"].append(item)
                        data["last_access"] = now_ts()
                        with self._cache_lock:
                            self.memory_cache[sid] = data
                    except Exception:
                        return
        with self._index_lock:
            if sid in self.index["shards"]:
                self.index["shards"][sid]["last_access"] = now_ts()
        path = self.index["shards"].get(sid, {}).get("path", os.path.join(self.shard_dir, f"{sid}.json"))
        with self._cache_lock:
            shard_copy = dict(self.memory_cache.get(sid, {}))
        self._write_q.put((path, shard_copy))
        self._save_index_async()

    def surface_relevant_shards(self, query: str, top_k: int = 6) -> List[Dict[str, Any]]:
        qtokens = set(query.lower().split())
        scores = []
        with self._index_lock:
            shards_items = list(self.index.get("shards", {}).items())
        with self._cache_lock:
            for sid, meta in shards_items:
                score = 0.0
                for tag in meta.get("tags", []):
                    try:
                        if tag.lower() in qtokens:
                            score += 0.6
                    except Exception:
                        pass
                cached = self.memory_cache.get(sid)
                if cached:
                    text = " ".join([(it.get("question", "") + " " + it.get("fragment", "")) for it in cached.get("items", [])[:4]])
                    tokens = set(text.lower().split())
                    if tokens:
                        overlap = len(qtokens & tokens) / max(1, len(qtokens | tokens))
                        score += overlap
                scores.append((sid, score))
        scores.sort(key=lambda x: -x[1])
        selected = [sid for sid, s in scores[:top_k] if s > 0]
        working = []
        with self._cache_lock:
            for sid in selected:
                cached = self.memory_cache.get(sid)
                if cached:
                    working.extend(cached.get("items", []))
                    cached["last_access"] = now_ts()
        with self._index_lock:
            for sid in selected:
                if sid in self.index["shards"]:
                    self.index["shards"][sid]["last_access"] = now_ts()
        return working

    def prune(self, prune_rate: float = METABOLISM_PRUNE_RATE):
        with self._index_lock:
            shards = list(self.index.get("shards", {}).items())
        if not shards:
            return []
        to_remove = int(len(shards) * prune_rate)
        removed = []
        for sid, _ in shards[:to_remove]:
            try:
                path = self.index["shards"][sid].get("path")
                if path and os.path.exists(path):
                    os.remove(path)
                with self._index_lock:
                    if sid in self.index["shards"]:
                        del self.index["shards"][sid]
                with self._cache_lock:
                    if sid in self.memory_cache:
                        del self.memory_cache[sid]
                removed.append(sid)
            except Exception:
                pass
        self._save_index_async()
        return removed

    def flush(self, wait: bool = False, timeout: float = 2.0):
        self._save_index_async()
        if wait:
            start = time.time()
            while not self._write_q.empty() and (time.time() - start) < timeout:
                time.sleep(0.02)

    def shutdown(self, wait_timeout: float = 6.0):
        try:
            self.flush(wait=True, timeout=wait_timeout)
        except Exception:
            pass
        try:
            self._write_q.put(None)
            self._writer_thread.join(timeout=wait_timeout)
        except Exception:
            pass

# -------------------------
# DistributedStore（持久层）
# -------------------------
class DistributedStore:
    def __init__(self, db_path: str = DISTRIBUTED_DB):
        self.db_path = db_path
        self._conn_lock = threading.Lock()
        self._ensure_schema()

    def _conn(self):
        conn = sqlite3.connect(self.db_path, check_same_thread=False)
        conn.row_factory = sqlite3.Row
        return conn

    def _ensure_schema(self):
        with self._conn_lock:
            conn = self._conn()
            try:
                cur = conn.cursor()
                cur.execute(""" CREATE TABLE IF NOT EXISTS shards ( id TEXT PRIMARY KEY, time TEXT, question TEXT, fragment TEXT, tags TEXT, weight REAL, last_access TEXT, extra TEXT ) """)
                try:
                    cur.execute("CREATE VIRTUAL TABLE IF NOT EXISTS shards_fts USING fts5(id, fragment, question, content='')")
                except Exception:
                    pass
                cur.execute("CREATE INDEX IF NOT EXISTS idx_shards_last_access ON shards(last_access)")
                conn.commit()
            finally:
                conn.close()

    def store(self, item: Dict[str,Any]) -> str:
        sid = uid()
        now = now_ts()
        question = item.get("question","")
        fragment = item.get("fragment","")
        tags = json.dumps(item.get("tags", []), ensure_ascii=False)
        weight = float(item.get("weight", 1.0))
        extra = json.dumps(item.get("meta", {}), ensure_ascii=False)
        with self._conn_lock:
            conn = self._conn()
            try:
                cur = conn.cursor()
                cur.execute("INSERT INTO shards (id, time, question, fragment, tags, weight, last_access, extra) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                            (sid, now, question, fragment, tags, weight, now, extra))
                try:
                    cur.execute("INSERT INTO shards_fts (id, fragment, question) VALUES (?, ?, ?)", (sid, fragment, question))
                except Exception:
                    pass
                conn.commit()
            finally:
                conn.close()
        persona_record_event("system", {"type":"distributed_store_write", "id": sid, "preview": fragment[:120]}, secure=(PRIVACY_MODE!="private_only"))
        return sid

    def search(self, query: str, top_k: int = 6) -> List[Dict[str,Any]]:
        q = query.replace("'", "''")
        with self._conn_lock:
            conn = self._conn()
            try:
                cur = conn.cursor()
                try:
                    cur.execute(f"SELECT id, fragment, question FROM shards_fts WHERE shards_fts MATCH ? LIMIT ?", (q, top_k))
                    rows = cur.fetchall()
                except Exception:
                    cur.execute("SELECT id, fragment, question FROM shards WHERE fragment LIKE ? OR question LIKE ? LIMIT ?", (f"%{query}%", f"%{query}%", top_k))
                    rows = cur.fetchall()
                results = []
                for r in rows:
                    rid = r["id"]
                    cur2 = conn.cursor()
                    cur2.execute("SELECT tags, weight, last_access, extra FROM shards WHERE id = ?", (rid,))
                    meta = cur2.fetchone()
                    tags = json.loads(meta["tags"]) if meta and meta["tags"] else []
                    weight = meta["weight"] if meta else 1.0
                    last_access = meta["last_access"] if meta else now_ts()
                    extra = json.loads(meta["extra"]) if meta and meta["extra"] else {}
                    results.append({"id": rid, "fragment": r["fragment"], "question": r["question"], "tags": tags, "weight": weight, "last_access": last_access, "meta": extra})
                return results
            finally:
                conn.close()

    def delete(self, sid: str):
        with self._conn_lock:
            conn = self._conn()
            try:
                cur = conn.cursor()
                cur.execute("DELETE FROM shards WHERE id = ?", (sid,))
                cur.execute("DELETE FROM shards_fts WHERE id = ?", (sid,))
                conn.commit()
            finally:
                conn.close()

    def compact(self):
        with self._conn_lock:
            conn = self._conn()
            try:
                conn.execute("VACUUM")
                conn.commit()
            finally:
                conn.close()

